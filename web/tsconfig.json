{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"allowJs": false,
		"checkJs": false,
		"sourceMap": true,
		"strict": true,
		"module": "ESNext",
		"target": "ESNext",
		"noFallthroughCasesInSwitch": true,
		"noImplicitOverride": true,
		"noPropertyAccessFromIndexSignature": true,
		"noUncheckedIndexedAccess": true
	},
	"include": ["src", "vite.config.ts", "playwright.config.ts"]
}
