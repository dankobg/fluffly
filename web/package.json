{
	"name": "fluffly-web",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev --host",
		"build": "vite build",
		"build-dev": "vite build --mode development",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test": "pnpm test:unit -- --run && pnpm test:e2e",
		"test:e2e": "playwright test",
		"gen:openapi": "openapi-typescript --enum ../api/schema/fluffly.yaml -o ./src/lib/gen/fluffly_openapi.ts",
		"gen": "pnpm gen:openapi"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.77.0",
		"@playwright/test": "^1.65.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/load-config": "^0.2.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^26.6.6",
		"@vitest/browser": "^5.1.1",
		"@vitest/browser-playwright": "^5.1.1",
		"bits-ui": "2.21.0",
		"clsx": "^2.1.1",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"formsnap": "^2.1.0",
		"globals": "^17.14.0",
		"layerchart": "2.11.0",
		"openapi-typescript": "^7.13.0",
		"playwright": "^1.65.1",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"shadcn-svelte": "^1.8.1",
		"svelte": "^5.59.1",
		"svelte-check": "^4.7.8",
		"svelte-sonner": "^1.2.3",
		"sveltekit-superforms": "^3.1.0",
		"tailwind-merge": "^3.7.1",
		"tailwind-variants": "^4.0.2",
		"tailwindcss": "^4.3.5",
		"tw-animate-css": "^1.4.0",
		"typescript": "6.0.3",
		"typescript-eslint": "^8.73.0",
		"vaul-svelte": "1.0.0-next.7",
		"vite": "^8.3.8",
		"vite-plugin-devtools-json": "^1.1.2",
		"vitest": "^5.1.1",
		"vitest-browser-svelte": "^3.1.0"
	},
	"dependencies": {
		"@ory/client-fetch": "^1.22.66",
		"@tanstack/svelte-table": "^9.3.2",
		"@uppy/core": "^6.3.2",
		"@uppy/dashboard": "^6.0.3",
		"@uppy/image-editor": "^5.0.1",
		"embla-carousel": "^8.6.0",
		"embla-carousel-svelte": "^8.6.0",
		"just-safe-set": "^4.2.1",
		"maplibre-gl": "^6.19.0",
		"mode-watcher": "^1.1.0",
		"openapi-fetch": "^0.17.0",
		"runed": "^0.38.0",
		"svelte-maplibre": "^2.0.1",
		"valibot": "^1.5.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
